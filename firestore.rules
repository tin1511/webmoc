rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /login_logs/{logId} {
      allow read, write: if true;
    }
    match /_metadata/{docId} {
      allow read, write: if true;
    }
  }
}
